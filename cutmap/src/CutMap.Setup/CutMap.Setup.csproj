<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CutMap 安装程序（NFR-03 的 setup.exe）。

    为什么是自研而不是 Inno Setup：本机拿不到 Inno Setup——winget 装它要管理员
    提权（非交互环境过不去），GitHub Releases 直连被墙（HTTP 000）。与其卡在
    工具上，不如自己写一个：只需要 .NET SDK，而且能做成**免管理员的按用户安装**，
    这反而更贴合"绿色版"的定位。

    载荷用「追加」而不是嵌入资源：把 payload.zip 直接接在 exe 字节后面，
    再写一段定长尾部记录偏移与长度。这样打包脚本不必重新编译安装器，
    重新追加一次即可，也避免 MSBuild 去啃一个几百 MB 的 EmbeddedResource。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\assets\cutmap.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CutMap-Setup</AssemblyName>
    <!-- 安装器自己不需要 PDB，几百 MB 的载荷旁边再放符号文件没意义 -->
    <DebugType>none</DebugType>

    <!--
      必须是单文件。自包含但非单文件时，publish 出来的是
      「exe + dll + 一堆运行时文件」，exe 单独拿走跑不起来——实测报
      "The application to execute does not exist: CutMap-Setup.dll"。
      而我们要往 exe 后面追加载荷，就只能有一个文件。

      IncludeNativeLibrariesForSelfExtract：把原生库也塞进包里，
      否则单文件 exe 运行时还要在旁边找它们。
      EnableCompressionInSingleFile：把打进包的内容压一遍，
      安装器本体会从 ~150 MB 降到 ~60 MB。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
