# 复制成 .env.local 后按需修改（.env.local 已被 .gitignore 忽略，令牌不会入库）。

# 瓦片集地址。默认 /terrain/（把 CutMap 产出的瓦片目录内容放进 public/terrain/）。
# 也可以指向任意 URL（如 http://127.0.0.1:8080/__tileset__/）。
VITE_TERRAIN_URL=/terrain/

# Cesium Ion 令牌（可选）。有它底图默认用 Bing 卫星影像；
# 申请：https://ion.cesium.com/tokens（只需 assets:read）。不要提交进仓库。
VITE_CESIUM_ION_TOKEN=

# 边界矢量地址（可选）。默认取 <瓦片集>/boundary.geojson
# ——CutMap 打包时会把矢量裁剪的边界统一拷成这个名字。
VITE_BOUNDARY_URL=
