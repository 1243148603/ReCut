<Project>

  <!--
    整个解决方案共享的构建设置。

    MSBuild 会自动向上查找这个文件，四个 csproj 不用各自重复一遍。
    放这里的两个理由：
      1. 程序集元数据（产品名/公司/版权/版本）统一，将来加项目不会漏
      2. **版本号只有这一处**——之前写死在 CutMapInfo.cs 里，
         打包脚本再拿正则去抠，两处迟早对不上

    版本号改了要同步改这里，不要改别处。CutMapInfo.Version 是运行时从程序集读的。
  -->

  <PropertyGroup>
    <Version>0.1.1</Version>
    <Product>CutMap</Product>
    <AssemblyName Condition="'$(AssemblyName)' == ''">$(MSBuildProjectName)</AssemblyName>
    <Company>CutMap</Company>
    <Copyright>Copyright (c) 2026 CutMap contributors</Copyright>

    <!-- 中文产品，别让编译器把警告文字按英文习惯截断 -->
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      分析级别用 latest，不用 latest-recommended。
      后者会带出 132 条 CA1305"数字格式跟区域设置走"——而那些绝大多数是
      **显示字符串**，本来就该跟区域走（中文界面下 223,495 带千分位是对的）。
      真正要管的是"拼进命令行/路径/机器可读格式"的那几处，已经单独修了，
      并在 .editorconfig 里把这条规则留给 Code 层。
    -->
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    ⚠ RuntimeIdentifier / SelfContained **不能放这里**。

    试过用 `Condition="'$(OutputType)' == 'Exe'"` 把它们统一给可执行项目，
    结果恒为假——**Directory.Build.props 在项目体之前求值，那时 OutputType 还没设**。
    后果很隐蔽：构建照样成功、安装包照样打得出来，只是**自包含运行时没被打进去**
    （实测发布目录里没有 coreclr.dll / hostfxr.dll），
    装到没装 .NET 的机器上直接起不来。

    所以这两个属性留在各项目的 csproj 里，那边 OutputType 是已知的。
  -->

</Project>
